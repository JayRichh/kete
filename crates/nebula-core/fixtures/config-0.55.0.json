{
  "account_spread": "failover",
  "account_spread_threshold": "80",
  "animations": false,
  "ask_before_archive": false,
  "auto_cleanup_merged": true,
  "black_background": false,
  "card_issue_number": false,
  "card_line_changes": true,
  "claude_effort": "high",
  "claude_enabled": false,
  "claude_model": "opus",
  "claude_models": [
    "claude-sonnet-5",
    "us.anthropic.claude-opus-5-v1:0"
  ],
  "close_finder_on_open": false,
  "codex_effort": "xhigh",
  "codex_enabled": false,
  "codex_model": "gpt-5.5",
  "confirm_drag_move": false,
  "confirm_on_archive": true,
  "cursor_effort": "high",
  "cursor_enabled": false,
  "cursor_model": "claude-opus-5-thinking",
  "custom_harnesses": [
    {
      "enabled": false,
      "hooks": "claude",
      "id": "agy",
      "label": "Agy",
      "model": "agy-large",
      "model_flag": "-m",
      "program": "/usr/local/bin/agy"
    }
  ],
  "delete_empty_worktree": true,
  "diff_context": "full",
  "diff_mode": "inline",
  "done_sound": "Ping",
  "editor": "nvim",
  "expand_all_worktrees": true,
  "feedback_sound": "off",
  "focus_tint": false,
  "follow_new_session": false,
  "git_init_on_create": false,
  "harnesses": {
    "claude": {
      "enabled": false,
      "label": "Claude Code"
    },
    "grok": {
      "label": "Grok",
      "model_flag": "--model",
      "program": "/usr/local/bin/grok"
    }
  },
  "hide_card_marks": true,
  "hide_card_prompt": true,
  "hide_done_subagents": false,
  "hide_draft_prs": true,
  "hide_projects": true,
  "hide_root_worktree": true,
  "hide_sessions": true,
  "hide_uninstalled_harnesses": true,
  "hide_worktrees": true,
  "highlight_current_card": false,
  "icons": "ascii",
  "inline_graphics": "sixel",
  "kanban": true,
  "kanban_scope": "all",
  "keybindings": {
    "git_diff": "ctrl+g, g",
    "quit": ""
  },
  "muse_effort": "high",
  "muse_enabled": false,
  "muse_model": "muse-1",
  "opencode_enabled": false,
  "opencode_model": "anthropic/claude-sonnet-5",
  "orchestrator_view": "always",
  "palette_enter_attaches": false,
  "pi_effort": "medium",
  "pi_enabled": false,
  "pi_model": "anthropic/claude-sonnet-5",
  "pr_issue_counts": false,
  "preset_text": "postfix",
  "prewarm_agents": false,
  "prewarm_sessions": false,
  "profiles": [
    {
      "name": "work",
      "harness": "claude",
      "default": true
    },
    {
      "name": "spare",
      "harness": "claude",
      "disabled": true,
      "env": {
        "CLAUDE_CODE_USE_BEDROCK": "1"
      }
    }
  ],
  "projects": {
    "/Users/me/src/app": {
      "open_command": "open http://localhost:3000",
      "run_command": "npm run dev"
    }
  },
  "quick_prompt_focus": true,
  "quick_prompt_kind": "codex",
  "quick_prompt_new_worktree": true,
  "recent_prompts": true,
  "recent_prompts_count": 5,
  "remember_harness": true,
  "session_idle_timeout": "30m",
  "session_pane": "bottom",
  "show_all_worktrees": false,
  "show_key_combos": true,
  "show_workspaces": false,
  "skip_session_naming": true,
  "source_control_graph": true,
  "ssh_sync_config": false,
  "subagent_retention": "4h",
  "theme": "ocean",
  "usage_statusline": false,
  "worktree_base_branch": "develop",
  "worktree_layout": "nested"
}
