{
  "name": "kete-desktop",
  "private": true,
  "version": "0.55.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/check-encoding.mjs && npm run icons && vite",
    "build": "node scripts/check-encoding.mjs && npm run icons && vite build",
    "check": "node scripts/check-encoding.mjs && npm run icons && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "tauri": "tauri",
    "icons": "node scripts/material-icons.mjs",
    "e2e:prepare": "node e2e/prepare.mjs",
    "e2e:run": "node --test --test-concurrency=1 e2e/desktop.e2e.mjs",
    "e2e": "npm run e2e:prepare && npm run e2e:run"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "geist": "^1.7.2",
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.2",
    "@tsconfig/svelte": "^5.0.8",
    "material-icon-theme": "^5.39.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
